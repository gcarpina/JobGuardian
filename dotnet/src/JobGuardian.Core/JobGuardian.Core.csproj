<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JobGuardian.Abstractions\JobGuardian.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    
    <PackageId>JobGuardian.Core</PackageId>

    <Description>
      Core runtime for JobGuardian, providing distributed job coordination,
      leader election, lease management and resilient execution across
      multiple application instances. JobGuardian helps ensure that a
      distributed job is executed by a single active owner at a time.
      JobGuardian is not a scheduler.
    </Description>

  </PropertyGroup>

</Project>